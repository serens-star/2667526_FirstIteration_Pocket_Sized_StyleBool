# --- Recommended: server-side key (never sent to the browser) ---
# Browser calls /api/generate; the server (Vercel function, or the Vite dev/preview server) holds the key.
VITE_AI_PROXY=/api/generate
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Quick local experiments only (key is visible in the browser; leave these empty when deploying) ---
# VITE_GEMINI_API_KEY=
# VITE_ANTHROPIC_API_KEY=
